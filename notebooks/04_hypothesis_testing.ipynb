   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.stats import norm\n",
    "\n",
    "# 1. Mengambil nilai Z-Statistic dari hasil pengujian sebelumnya\n",
    "z_stat = 5.4433  # Nilai riil dari pengujian User vs Bot kamu\n",
    "alpha = 0.05\n",
    "z_critical = norm.ppf(1 - alpha/2) # Batas kritis uji dua arah (~1.96)\n",
    "\n",
    "# 2. Membuat deret angka untuk sumbu X kurva distribusi\n",
    "x = np.linspace(-6, 6, 1000)\n",
    "y = norm.pdf(x)\n",
    "\n",
    "plt.figure(figsize=(10, 5))\n",
    "\n",
    "# 3. Menggambar kurva distribusi standar normal (Lonceng)\n",
    "plt.plot(x, y, label='Distribusi Standar Normal (Z)', color='blue', linewidth=2)\n",
    "\n",
    "# 4. Mewarnai Daerah Penolakan H0 (Arsir Merah di ujung kiri & kanan)\n",
    "x_reject_left = np.linspace(-6, -z_critical, 100)\n",
    "plt.fill_between(x_reject_left, norm.pdf(x_reject_left), color='red', alpha=0.3, label='Daerah Penolakan H0')\n",
    "\n",
    "x_reject_right = np.linspace(z_critical, 6, 100)\n",
    "plt.fill_between(x_reject_right, norm.pdf(x_reject_right), color='red', alpha=0.3)\n",
    "\n",
    "# 5. Menggambar garis putus-putus hijau penanda posisi Z-Statistic kamu\n",
    "plt.axvline(z_stat, color='green', linestyle='--', linewidth=2, label=f'Z-Statistik Kamu ({z_stat:.4f})')\n",
    "\n",
    "# 6. Menambahkan Detail Label, Judul, dan Desain Grafik\n",
    "plt.title('Plot Audit Uji Hipotesis (Two-Sample Z-Test) — User vs Bot via PR', fontsize=12, fontweight='bold')\n",
    "plt.xlabel('Nilai Z', fontsize=10)\n",
    "plt.ylabel('Densitas', fontsize=10)\n",
    "plt.grid(True, linestyle=':', alpha=0.6)\n",
    "plt.legend(loc='upper left')\n",
    "\n",
    "# Mengatur batas tampilan sumbu X agar garis hijau 5.44 terlihat jelas\n",
    "plt.xlim(-6, 6)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
